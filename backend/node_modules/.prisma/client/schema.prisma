generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum VehicleType {
  SCOOTER
  MOTORCYCLE
  BICYCLE
  EBIKE
}

enum VehicleStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  OPEN
  BLOCKED
  BOOKED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  CANCELLED
  ACTIVE
  COMPLETED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  RENTAL
  DEPOSIT
  REFUND
}

// Which gateway actually processed the payment. MOCK is the only live
// provider in v1.1; RAZORPAY is wired into the schema/service layer so a
// real integration can be dropped in later without another migration.
enum PaymentProvider {
  MOCK
  RAZORPAY
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum DocumentType {
  GOVT_ID
  DRIVING_LICENSE
  VEHICLE_RC
  VEHICLE_INSURANCE
  VEHICLE_PHOTO
  OTHER
}

enum VerificationType {
  USER_IDENTITY
  OWNER_KYC
  VEHICLE_DOCUMENTS
}

enum NotificationType {
  BOOKING
  PAYMENT
  VERIFICATION
  VEHICLE
  SYSTEM
}

// ---------- MODELS ----------

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  phone              String?            @unique
  passwordHash       String
  role               Role               @default(CUSTOMER)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isSuspended        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vehicles            Vehicle[]            @relation("OwnerVehicles")
  bookings            Booking[]            @relation("CustomerBookings")
  reviews             Review[]             @relation("CustomerReviews")
  documents           UserDocument[]
  verificationRecords VerificationRecord[] @relation("UserVerification")
  reviewedRecords     VerificationRecord[] @relation("ReviewerVerification")
  notifications       Notification[]
  disputesRaised      Dispute[]            @relation("RaisedDisputes")
  disputesResolved    Dispute[]            @relation("ResolvedDisputes")

  @@index([role])
}

model Vehicle {
  id                    String             @id @default(uuid())
  ownerId               String
  owner                 User               @relation("OwnerVehicles", fields: [ownerId], references: [id])
  brand                 String
  model                 String
  vehicleType           VehicleType
  registrationReference String
  pricePerDay           Decimal            @db.Decimal(10, 2)
  securityDeposit       Decimal            @db.Decimal(10, 2)
  city                  String
  latitude              Float
  longitude             Float
  description           String?
  photoUrls             String[]
  status                VehicleStatus      @default(DRAFT)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  ratingAvg             Float              @default(0)
  ratingCount           Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  documents           VehicleDocument[]
  availability        Availability[]
  bookings            Booking[]
  reviews             Review[]
  verificationRecords VerificationRecord[] @relation("VehicleVerification")

  @@index([status])
  @@index([latitude, longitude])
}

model VehicleDocument {
  id                  String             @id @default(uuid())
  vehicleId           String
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType        DocumentType
  secureFileReference String
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  createdAt           DateTime           @default(now())
}

model UserDocument {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType        DocumentType
  secureFileReference String
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  createdAt           DateTime           @default(now())
}

model Availability {
  id        String             @id @default(uuid())
  vehicleId String
  vehicle   Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  status    AvailabilityStatus @default(OPEN)
  createdAt DateTime           @default(now())

  @@index([vehicleId, startTime, endTime])
}

model Booking {
  id              String        @id @default(uuid())
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  startTime       DateTime
  endTime         DateTime
  pickupLocation  String
  returnLocation  String
  rentalAmount    Decimal       @db.Decimal(10, 2)
  securityDeposit Decimal       @db.Decimal(10, 2)
  platformFee     Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING_PAYMENT)
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments Payment[]
  review   Review?
  disputes Dispute[]

  @@index([vehicleId, startTime, endTime])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id                String          @id @default(uuid())
  bookingId         String
  booking           Booking         @relation(fields: [bookingId], references: [id])
  provider          PaymentProvider @default(MOCK)
  method            String? // UPI | CARD | NETBANKING | WALLET (mock-selected method)
  transactionId     String? // provider-issued reference; MOCK_TXN_xxx for the mock provider
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentType       PaymentType     @default(RENTAL)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([bookingId])
  @@index([razorpayOrderId])
  @@index([transactionId])
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([vehicleId])
}

model VerificationRecord {
  id               String             @id @default(uuid())
  verificationType VerificationType
  userId           String?
  user             User?              @relation("UserVerification", fields: [userId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?           @relation("VehicleVerification", fields: [vehicleId], references: [id])
  status           VerificationStatus @default(PENDING)
  reviewedById     String?
  reviewedBy       User?              @relation("ReviewerVerification", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  notes            String?
  createdAt        DateTime           @default(now())

  @@index([status])
}

model Dispute {
  id             String        @id @default(uuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id])
  raisedById     String
  raisedBy       User          @relation("RaisedDisputes", fields: [raisedById], references: [id])
  subject        String
  description    String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?         @relation("ResolvedDisputes", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([bookingId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}
