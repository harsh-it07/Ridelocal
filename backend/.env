# PostgreSQL connection.
# Recommended for local dev (no Docker required): create a free Postgres
# database at https://neon.tech or https://supabase.com and paste its
# connection string here. Or point this at a local Postgres install.
DATABASE_URL="postgresql://postgres:Harshit@8379@db.hohmzflxmbmnttaqbskw.supabase.co:5432/postgres"

# App
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Platform economics
PLATFORM_FEE_PERCENT=8

# Payments run on the built-in MOCK provider in v1.1 -- no keys needed.
# These are only read if you later swap RazorpayProvider in as the active
# provider (see backend/src/modules/payments/payments.service.ts).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local file uploads (driving licences, RC certificates, bike photos)
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=8
